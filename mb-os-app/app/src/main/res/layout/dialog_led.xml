<?xml version="1.0" encoding="utf-8"?>
<!--
  LED 点阵画板对话框（M3 Expressive，v4.2 修复分屏裁切）：
  历史缺陷：根节点无滚动容器，5×5 网格 + 标题 + 按钮在分屏小窗（高 <480dp）
  下底部按钮被直接裁掉。现内容整体包进 NestedScrollView——
  根仍为 wrap_content 高度（内容短时对话框自适应），内容超高时内部滚动可达。
  @color/mb_board 板子色保留：还原 micro:bit 物理点阵屏观感。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/func_led"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/led_hint"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- 深色「板子」容器：还原 micro:bit 点阵屏观感，熄灭的 LED 也清晰可见 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/mb_board"
                app:cardCornerRadius="@dimen/shape_card"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <GridLayout
                    android:id="@+id/gridLed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_margin="12dp"
                    android:columnCount="5"
                    android:rowCount="5" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClear"
                    style="@style/Mb.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/led_clear" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShow"
                    style="@style/Mb.Button.Filled"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/led_send" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
