<?xml version="1.0" encoding="utf-8"?>
<!--
  控制台快捷入口卡（v4.2.4：可自定义，默认 LED 画板 / 表情库）：
  46dp 圆形图标容器（MaterialCardView，代码按主/次/第三容器色循环）+ 标题 + 两行说明。
  两张卡横向均分（Kotlin 覆盖 LayoutParams 为 0dp + weight=1），等高由 minHeight 兜底。
  字段名固定：iconWrap / ivIcon / tvTitle / tvDesc。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Mb.Page.Card"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="132dp">

    <LinearLayout style="@style/Mb.Page.CardBody">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iconWrap"
            android:layout_width="@dimen/icon_circle"
            android:layout_height="@dimen/icon_circle"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="@dimen/icon_circle"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_grid"
                app:tint="?attr/colorOnPrimaryContainer" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Mb.CardTitle"
            android:layout_marginTop="14dp" />

        <TextView
            android:id="@+id/tvDesc"
            style="@style/Mb.CardDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
