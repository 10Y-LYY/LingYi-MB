<?xml version="1.0" encoding="utf-8"?>
<!--
  MakeCode 引导页（M3 Expressive，v4.2 令牌化）：
  - 主入口卡保留 hero 范式（20dp 大圆角卡 + 46dp bg_icon_circle 图标圆 +
    大标题 + 全宽主按钮），图标容器由 52dp 方块卡换为 bg_icon_circle 圆形语义；
  - 三步指引卡保留；一键刷入卡保留 SecondaryContainer  tonal 底（Mb.Page.Card
    之上显式覆写 cardBackgroundColor，语义不变）；
  - 全页仅 hero 一个 Filled 主按钮，刷入卡按钮降为 Outlined（Mb.Button 档位纪律）。
  保留全部 id：btnOpenMakecode、btnFlashHex。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLow"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/makecode_title" />

    <!-- 大屏内容封顶居中（M3 规范：单列 ≤840dp，手机窄屏零副作用） -->
    <com.lingyi.mbos.ui.MaxWidthFrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:maxWidth="@dimen/content_max_width">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:clipToPadding="false"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_gutter_h"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/page_gutter_h"
                android:paddingBottom="28dp">

                <!-- 主入口卡片（hero 范式） -->
                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <FrameLayout
                            android:layout_width="@dimen/icon_circle"
                            android:layout_height="@dimen/icon_circle"
                            android:background="@drawable/bg_icon_circle">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                app:srcCompat="@drawable/ic_code"
                                app:tint="?attr/colorOnPrimaryContainer" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/makecode_hero_title"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/makecode_hero_desc"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenMakecode"
                            style="@style/Mb.Button.Filled"
                            android:layout_marginTop="16dp"
                            android:text="@string/makecode_open"
                            app:icon="@drawable/ic_code"
                            app:iconGravity="textStart"
                            app:iconTint="?attr/colorOnPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 三步指引 -->
                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <TextView
                            style="@style/Mb.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/makecode_steps_title" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="6dp"
                            android:text="@string/makecode_steps"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 一键刷入（SecondaryContainer tonal 底保留） -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Mb.Page.Card"
                    app:cardBackgroundColor="?attr/colorSecondaryContainer">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <TextView
                            style="@style/Mb.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/makecode_flash_title"
                            android:textColor="?attr/colorOnSecondaryContainer" />

                        <TextView
                            style="@style/Mb.CardDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/makecode_flash_desc"
                            android:textColor="?attr/colorOnSecondaryContainer" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFlashHex"
                            style="@style/Mb.Button.Outlined"
                            android:layout_marginTop="12dp"
                            android:text="@string/makecode_flash_btn"
                            app:icon="@drawable/ic_flash"
                            app:iconGravity="textStart"
                            app:iconTint="?attr/colorPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/makecode_note"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.lingyi.mbos.ui.MaxWidthFrameLayout>
</LinearLayout>
