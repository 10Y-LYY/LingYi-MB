<?xml version="1.0" encoding="utf-8"?>
<!--
  全 App 标准列表行（v4.2 M3 Expressive）：
  46dp 圆图标容器 + 标题（TitleSmall）+ 描述（BodySmall）+ 20dp chevron，
  minHeight 72dp，整行按压反馈（selectableItemBackground）。

  说明：iconWrap 保持 MaterialCardView —— MainActivity / ConsoleCategoryActivity
  通过 ViewBinding 调用 ib.iconWrap.setCardBackgroundColor() 循环切换
  primary / secondary / tertiary 容器色；46dp 卡片配 @dimen/icon_circle 大圆角，
  由 Material 的 ShapeAppearancePathProvider 钳制为等价正圆（视觉同 bg_icon_circle），
  无需为每行动态换背景 drawable。本布局被代码动态填充，字段名（iconWrap / ivIcon /
  tvTitle / tvDesc）不得改。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/iconWrap"
        android:layout_width="@dimen/icon_circle"
        android:layout_height="@dimen/icon_circle"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:cardCornerRadius="@dimen/icon_circle"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            app:srcCompat="@drawable/ic_text"
            app:tint="?attr/colorOnPrimaryContainer" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Mb.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/func_scroll" />

        <TextView
            android:id="@+id/tvDesc"
            style="@style/Mb.CardDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/func_scroll_desc" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="6dp"
        android:contentDescription="进入"
        app:srcCompat="@drawable/ic_chevron_right"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
