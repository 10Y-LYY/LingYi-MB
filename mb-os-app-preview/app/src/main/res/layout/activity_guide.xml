<?xml version="1.0" encoding="utf-8"?>
<!--
  引导页（冷启动门面，v4.2 M3 Expressive 重排为 Play 商店首屏节奏）：
  根 LinearLayout(vertical) > MaxWidthFrameLayout(0dp, weight=1) > NestedScrollView 骨架不变。

  层次（从上到下）：
    ① 品牌头区：logo + 标题 + 副标题 + 版本行 + 导语 tonal 卡；
    ② 主选择区：Mb.SectionHeader「选择连接方式」+ ChipGroup（BLE/USB）+ 连接提示/状态；
    ③ 唯一主 CTA：Mb.Page.Card.Accent 卡包 Mb.Button.Filled「连接 micro:bit」；
       次级动作降级为 Outlined（已配对设备）/ Tonal（进入控制台）；
    ④ 次级内容卡：刷机卡（cardFlash）+ 两张 gone 条件卡（cardUpdate / cardNoConn）；
    ⑤ 开发者入口（gone）+ 稳定性工具问号卡（cardStabilityTools）+ gone 离线卡（cardOffline）。

  历史问题（保留注释）：引导页曾直接把 MaxWidthFrameLayout 作根、内嵌普通 ScrollView，
  在部分机型/窗口形态（小窗、分屏、异常 MeasureSpec）下出现内容左移出界、
  文字只剩尾部、滚动条错位。改为经全量验证的结构后彻底消除该风险。

  设计令牌：卡片 Mb.Page.Card* / Mb.Page.CardBody / Mb.SectionHeader / Mb.CardTitle /
  Mb.CardDesc / Mb.Button.Filled|Tonal|Outlined；圆角容器 bg_icon_circle + 矢量图标。
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLow"
    android:orientation="vertical">

    <com.lingyi.mbos.ui.MaxWidthFrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:maxWidth="@dimen/content_max_width">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:clipToPadding="false"
            android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_gutter_h_wide"
            android:paddingEnd="@dimen/page_gutter_h_wide"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

        <!-- ============ ① 品牌头区 ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center_horizontal"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="@dimen/shape_card"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_app_logo"
                android:contentDescription="@string/app_name" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:text="@string/guide_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="@string/app_subtitle"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- 版本信息行：直读板载固件版本与软件版本（连接后自动刷新） -->
        <TextView
            android:id="@+id/tvVersionInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="@string/guide_version_loading"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- 导语：tonal 卡与页面底色分层，不抢主 CTA -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Mb.Page.Card.Tonal"
            android:layout_marginTop="@dimen/space_section_top">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/guide_desc"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ ② 主选择区：连接方式（ChipGroup 上移为主选择） ============ -->
        <TextView
            style="@style/Mb.SectionHeader"
            android:text="@string/guide_choose_conn" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBle"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/conn_ble"
                app:chipIcon="@drawable/ic_bluetooth" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUsb"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conn_usb"
                app:chipIcon="@drawable/ic_usb" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/tvConnHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/conn_ble_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.lingyi.mbos.ui.BlockLoadingView
            android:id="@+id/blockLoading"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="@string/guide_disconnected"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- ============ ③ 唯一主 CTA：Accent 卡包 Filled 大按钮 ============ -->
        <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card.Accent">

            <LinearLayout style="@style/Mb.Page.CardBody">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnect"
                    style="@style/Mb.Button.Filled"
                    android:text="@string/guide_connect" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 次级动作：降级为 Outlined / Tonal，不再与主 CTA 抢层级 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickBonded"
            style="@style/Mb.Button.Outlined"
            android:layout_marginTop="@dimen/space_card"
            android:text="@string/guide_pick_bonded" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnter"
            style="@style/Mb.Button.Tonal"
            android:layout_marginTop="@dimen/space_card"
            android:enabled="false"
            android:text="@string/guide_enter" />

        <!-- ============ ④ 刷机卡（连接后的次要流程） ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFlash"
            style="@style/Mb.Page.Card">

            <LinearLayout style="@style/Mb.Page.CardBody">

                <TextView
                    android:id="@+id/tvFlashTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_flash_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFlashDesc"
                    style="@style/Mb.CardDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/guide_flash_desc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFlash"
                    style="@style/Mb.Button.Tonal"
                    android:layout_marginTop="14dp"
                    android:text="@string/guide_flash" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportFw"
                    style="@style/Mb.Button.Outlined"
                    android:layout_marginTop="8dp"
                    android:text="@string/guide_flash_export" />

                <TextView
                    android:id="@+id/tvFlashStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/guide_flash_idle"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 更新提示卡：仅当真实联网检查到新版本时显示（优先级高于刷机卡/未连接卡） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorTertiaryContainer"
            app:cardCornerRadius="@dimen/shape_card"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/update_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnTertiaryContainer"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUpdateDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/update_desc"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnTertiaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpdate"
                    style="@style/Mb.Button.Filled"
                    android:layout_marginTop="14dp"
                    android:text="@string/update_go" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 未连接小提示：非首次启动且无需更新时显示，替代大号刷机卡（占位小而轻） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNoConn"
            style="@style/Mb.Page.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/noconn_title"
                    app:srcCompat="@drawable/ic_usb"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/noconn_title"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/noconn_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ ⑤ 开发者入口（默认隐藏，连按提示常驻） ============ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDev"
            style="@style/Mb.Button.Tonal"
            android:layout_marginTop="@dimen/space_card"
            android:visibility="gone"
            android:text="@string/dev_entry" />

        <!-- 开发者专用：跳过连接要求，直接进入控制台调试 UI -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDevConsole"
            style="@style/Mb.Button.Outlined"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:text="@string/dev_entry_console" />

        <TextView
            android:id="@+id/tvDevHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="@string/dev_unlock_hint_plain"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- ============ 稳定性工具（4.1.0-preview → 4.1.1 收敂为单一问号入口） ============ -->
        <!-- 引导页只留一个问号入口，全部稳定性工具收进二级页面（StabilityToolsActivity），
             主页保持清爽；遇到问题（连不上 / 闪退 / 固件存疑）时点这里逐项排查。 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStabilityTools"
            style="@style/Mb.Page.Card"
            android:layout_marginTop="@dimen/space_section_top"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- 圆形图标容器：bg_icon_circle + ic_help 矢量（替代原「?」文字圆卡） -->
                <FrameLayout
                    android:layout_width="@dimen/icon_circle"
                    android:layout_height="@dimen/icon_circle"
                    android:background="@drawable/bg_icon_circle">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="稳定性工具"
                        app:srcCompat="@drawable/ic_help"
                        app:tint="?attr/colorOnPrimaryContainer" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Mb.CardTitle"
                        android:text="稳定性工具" />

                    <TextView
                        style="@style/Mb.CardDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="自检 · 常见问题 · 固件对比 · 连接向导，遇到问题点这里" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="进入"
                    app:srcCompat="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 无网可用提示：检测到无网络时显示（核心功能离线可用） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOffline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorTertiaryContainer"
            app:cardCornerRadius="@dimen/shape_card"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📴 当前离线，但核心功能照常可用"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnTertiaryContainer"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="3dp"
                    android:text="连接 / 控制 / 预览 / 指针都不需要网络；仅「检查更新」需要联网，恢复网络后可再试。"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnTertiaryContainer" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_section_top"
            android:text="10Y-灵逸云科技 · 灵逸 MB"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.lingyi.mbos.ui.MaxWidthFrameLayout>
</LinearLayout>
