<?xml version="1.0" encoding="utf-8"?>
<!--
  控制台「大方格」主题的分类卡（M3，v4.2 对齐 Expressive 令牌）：
  中性卡面 + 彩色图标容器 + 标题 + 功能数，点卡进二级页面挑选。
  仅在 Activity 上下文使用（Theme.MBOS 为 Material3 主题，卡片主题校验安全）。

  注意（v3.3.0-preview 修复）：本卡只会被 addView 进「纵向」LinearLayout 列容器，
  纵向容器里 layout_weight 只作用于高度、不作用于宽度，
  历史上根视图写成 width=0dp + weight=1 导致卡片宽度为 0、整张卡不可见
  （表现为「功能」区只剩一张巨大空卡）。故根视图固定为 match_parent/wrap_content，
  且 MainActivity.buildFuncGrid 添加时仍会显式覆盖 LayoutParams 双保险。

  v4.2：根卡走 Mb.Page.Card（20dp 圆角 / 无描边 / 零 elevation）；
  图标容器圆角改 @dimen/shape_card_medium（16dp）与卡圆角呼应；
  iconWrap 保持 MaterialCardView（Kotlin 走 setCardBackgroundColor 循环容器色）。
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Mb.Page.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="148dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iconWrap"
            android:layout_width="@dimen/icon_circle"
            android:layout_height="@dimen/icon_circle"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="@dimen/shape_card_medium"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_grid"
                app:tint="?attr/colorOnPrimaryContainer" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Mb.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card"
            android:text="@string/func_led" />

        <TextView
            android:id="@+id/tvDesc"
            style="@style/Mb.CardDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/func_led_desc" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/console_feature_count"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorPrimary" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="进入"
                app:srcCompat="@drawable/ic_chevron_right"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
