<?xml version="1.0" encoding="utf-8"?>
<!--
  关于页（M3 Expressive 重排）：
  - 全宽按钮按层级重组：每张卡至多一个 Mb.Button.Tonal 主操作，
    其余降级为带矢量图标的 Mb.Button.Outlined / Mb.Button.Text 列表行；
  - emoji 全部换成 drawable 矢量图标；卡片统一 Mb.Page.Card（20dp 圆角 / 无描边）；
  - 长文案按钮保持 maxLines=2 不裁切，一律 wrap_content 高度，无固定高度；
  - 全部 view id 原样保留。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLow"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/about_title" />

    <!-- 大屏内容封顶居中（M3 规范：单列 ≤840dp，手机窄屏零副作用） -->
    <com.lingyi.mbos.ui.MaxWidthFrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:maxWidth="@dimen/content_max_width">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:clipToPadding="false"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_gutter_h"
                android:paddingTop="@dimen/space_card"
                android:paddingEnd="@dimen/page_gutter_h"
                android:paddingBottom="28dp">

                <!-- 应用标识 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        app:cardBackgroundColor="?attr/colorPrimaryContainer"
                        app:cardCornerRadius="@dimen/shape_card"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/app_name"
                            app:srcCompat="@drawable/ic_app_logo" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/page_gutter_h"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/app_subtitle"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvVersion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="版本 -"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 关于本应用 -->
                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <TextView
                            style="@style/Mb.CardTitle"
                            android:text="关于本应用" />

                        <TextView
                            style="@style/Mb.CardDesc"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/about_desc" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/about_company"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 检查更新（真实联网）：本卡唯一 Tonal 主操作 -->
                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <TextView
                            style="@style/Mb.CardTitle"
                            android:text="检查更新" />

                        <TextView
                            style="@style/Mb.CardDesc"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/update_desc" />

                        <!-- 更新通道：下拉选择稳定版 / 预览版（替代开发者页的布尔开关） -->
                        <com.lingyi.mbos.ui.UpdateChannelPicker
                            android:id="@+id/channelPicker"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card" />

                        <TextView
                            android:id="@+id/tvUpdateStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/update_checking"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCheckUpdate"
                                style="@style/Mb.Button.Tonal"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/about_check_update"
                                app:icon="@drawable/ic_refresh"
                                app:iconGravity="textStart"
                                app:iconSize="20dp"
                                app:iconTint="?attr/colorOnSecondaryContainer" />

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/pbCheckUpdate"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="@dimen/space_card"
                                android:indeterminate="true"
                                android:visibility="gone"
                                app:indicatorColor="?attr/colorPrimary"
                                app:indicatorSize="24dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 错误日志与反馈（一键发送到开发者邮箱） -->
                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <TextView
                            style="@style/Mb.CardTitle"
                            android:text="@string/log_feedback_title" />

                        <TextView
                            style="@style/Mb.CardDesc"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/log_feedback_desc" />

                        <TextView
                            android:id="@+id/tvLogStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="-"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSendLog"
                            style="@style/Mb.Button.Tonal"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/log_send_email"
                            app:icon="@drawable/ic_flashlog"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorOnSecondaryContainer" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShareLog"
                            style="@style/Mb.Button.Outlined"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/log_share"
                            app:icon="@drawable/ic_logstream"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnViewLog"
                            style="@style/Mb.Button.Text"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/log_view"
                            app:icon="@drawable/ic_scriptinfo"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearLog"
                            style="@style/Mb.Button.Text"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/log_clear"
                            app:icon="@drawable/ic_clear"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 稳定性与反馈：与其余卡统一 20dp 圆角 / 无描边 -->
                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <TextView
                            style="@style/Mb.CardTitle"
                            android:text="稳定性与反馈" />

                        <TextView
                            style="@style/Mb.CardDesc"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="出问题时，这些工具能帮你把现场完整带给开发者" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDiagnostic"
                            style="@style/Mb.Button.Tonal"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="一键诊断报告"
                            app:icon="@drawable/ic_sensortest"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorOnSecondaryContainer" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFeedbackTemplate"
                            style="@style/Mb.Button.Text"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="反馈模板（按向导描述问题）"
                            app:icon="@drawable/ic_text"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUpdateRetry"
                            style="@style/Mb.Button.Text"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="更新检查重试（带网络诊断）"
                            app:icon="@drawable/ic_refresh"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChannelExplainer"
                            style="@style/Mb.Button.Text"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="稳定版 / 预览版通道说明"
                            app:icon="@drawable/ic_info"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDependencies"
                            style="@style/Mb.Button.Text"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="第三方依赖清单"
                            app:icon="@drawable/ic_codelib"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 更多 -->
                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <TextView
                            style="@style/Mb.CardTitle"
                            android:text="更多" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVisitPage"
                            style="@style/Mb.Button.Outlined"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/about_visit_page"
                            app:icon="@drawable/ic_linkmonitor"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLicense"
                            style="@style/Mb.Button.Text"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/about_license"
                            app:icon="@drawable/ic_scriptinfo"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSettings"
                            style="@style/Mb.Button.Text"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/settings_title"
                            app:icon="@drawable/ic_tool"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyVersion"
                            style="@style/Mb.Button.Text"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/about_copy_version"
                            app:icon="@drawable/ic_text"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDev"
                            style="@style/Mb.Button.Text"
                            android:layout_marginTop="@dimen/space_card"
                            android:visibility="gone"
                            android:text="@string/dev_open"
                            app:icon="@drawable/ic_code"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary" />

                        <!-- 开发者入口下方的署名 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/about_powered_by"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_section_top"
                    android:text="10Y-灵逸云科技 · 灵逸 MB"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- 页尾版权行：© + 开发团队 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_card"
                    android:text="@string/about_copyright"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.lingyi.mbos.ui.MaxWidthFrameLayout>
</LinearLayout>
