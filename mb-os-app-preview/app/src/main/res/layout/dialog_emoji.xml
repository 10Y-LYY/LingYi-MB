<?xml version="1.0" encoding="utf-8"?>
<!--
  表情选择对话框（M3 Expressive，v4.2 修复溢出）：
  历史缺陷：表情按钮由 MainActivity.openEmojiDialog 运行时 addView 进
  emojiContainer，容器无滚动，表情多时直接溢出屏幕。
  现结构：根 LinearLayout(wrap_content) > NestedScrollView > emojiContainer。
  emojiContainer 保持为纵向 LinearLayout（Kotlin 侧
  findViewById<ViewGroup>(R.id.emojiContainer).addView(btn) 契约不变），
  标题作为首子项保留，运行时按钮追加其后，超高时随 NestedScrollView 滚动。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/emojiContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/func_emoji"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
