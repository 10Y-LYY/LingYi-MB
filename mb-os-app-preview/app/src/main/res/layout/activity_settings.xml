<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页（M3 Expressive 重排）：
  - 5 个分区标题统一 Mb.SectionHeader；卡片统一 Mb.Page.Card（20dp 圆角 / 无描边 / 零 elevation）；
  - 外观按 ChipGroup 拆 tonal 子卡；开关行统一「文字组 + MaterialSwitch」横排；
  - 按钮按 Mb.Button.Filled/Tonal/Outlined/Text 四档分级（每卡至多一个 Tonal/Filled）；
  - 全部 Slider id 与 valueFrom/valueTo/stepSize 原样保留。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLow"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/settings_title" />

    <!-- 大屏内容封顶居中（M3 规范：单列 ≤840dp，手机窄屏零副作用） -->
    <com.lingyi.mbos.ui.MaxWidthFrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:maxWidth="@dimen/content_max_width">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:clipToPadding="false"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/settingsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_gutter_h"
                android:paddingTop="@dimen/space_card"
                android:paddingEnd="@dimen/page_gutter_h"
                android:paddingBottom="28dp">

                <!-- ============ 外观 ============ -->
                <TextView
                    android:id="@+id/tvSectionAppearance"
                    style="@style/Mb.SectionHeader"
                    android:text="@string/settings_section_appearance" />

                <!-- 主题卡：模式 / 主题色各拆 tonal 子卡 -->
                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <TextView
                            style="@style/Mb.CardTitle"
                            android:text="@string/settings_theme_mode" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                            app:cardCornerRadius="@dimen/shape_inner"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout style="@style/Mb.Page.CardBody">

                                <com.google.android.material.chip.ChipGroup
                                    android:id="@+id/cgThemeMode"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:selectionRequired="true"
                                    app:singleSelection="true">

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipModeSystem"
                                        style="@style/Widget.Material3.Chip.Filter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/settings_theme_mode_system" />

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipModeLight"
                                        style="@style/Widget.Material3.Chip.Filter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/settings_theme_mode_light" />

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipModeDark"
                                        style="@style/Widget.Material3.Chip.Filter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/settings_theme_mode_dark" />
                                </com.google.android.material.chip.ChipGroup>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            style="@style/Mb.CardTitle"
                            android:layout_marginTop="@dimen/space_section_top"
                            android:text="@string/settings_theme_color" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                            app:cardCornerRadius="@dimen/shape_inner"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout style="@style/Mb.Page.CardBody">

                                <com.google.android.material.chip.ChipGroup
                                    android:id="@+id/cgThemeColor"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:selectionRequired="true"
                                    app:singleSelection="true">

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipColorDynamic"
                                        style="@style/Widget.Material3.Chip.Filter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/settings_theme_color_dynamic" />

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipColorM3"
                                        style="@style/Widget.Material3.Chip.Filter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/settings_theme_color_m3" />

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipColorTeal"
                                        style="@style/Widget.Material3.Chip.Filter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/settings_theme_color_teal" />

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipColorGold"
                                        style="@style/Widget.Material3.Chip.Filter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/settings_theme_color_gold" />

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipColorIndigo"
                                        style="@style/Widget.Material3.Chip.Filter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/settings_theme_color_indigo" />

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipColorRose"
                                        style="@style/Widget.Material3.Chip.Filter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/settings_theme_color_rose" />

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipColorForest"
                                        style="@style/Widget.Material3.Chip.Filter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/settings_theme_color_forest" />
                                </com.google.android.material.chip.ChipGroup>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvDynamicHint"
                            style="@style/Mb.CardDesc"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/settings_theme_dynamic_unsupported"
                            android:textColor="?attr/colorError"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 界面卡：过渡动画开关 + 控制台布局 -->
                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <!-- 界面过渡动画 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Mb.CardTitle"
                                    android:text="@string/settings_animation" />

                                <TextView
                                    style="@style/Mb.CardDesc"
                                    android:text="@string/settings_animation_desc" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swAnimation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <!-- 控制台布局（列表 / 大方格） -->
                        <TextView
                            style="@style/Mb.CardTitle"
                            android:layout_marginTop="@dimen/space_section_top"
                            android:text="@string/settings_console_style" />

                        <TextView
                            style="@style/Mb.CardDesc"
                            android:text="@string/settings_console_style_desc" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/cgConsoleStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipConsoleList"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_console_style_list" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipConsoleGrid"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_console_style_grid" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ 连接 ============ -->
                <TextView
                    style="@style/Mb.SectionHeader"
                    android:text="@string/settings_section_connection" />

                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <TextView
                            style="@style/Mb.CardTitle"
                            android:text="@string/settings_default_conn" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/cgDefaultConn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipConnBle"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/conn_ble" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipConnUsb"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/conn_usb" />
                        </com.google.android.material.chip.ChipGroup>

                        <TextView
                            style="@style/Mb.CardDesc"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/settings_default_conn_desc" />

                        <TextView
                            style="@style/Mb.CardTitle"
                            android:layout_marginTop="@dimen/space_section_top"
                            android:text="@string/settings_read_interval" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/cgReadInterval"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipInterval1s"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_interval_1s" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipInterval2s"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_interval_2s" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipInterval5s"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_interval_5s" />
                        </com.google.android.material.chip.ChipGroup>

                        <TextView
                            style="@style/Mb.CardDesc"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/settings_read_interval_desc" />

                        <!-- 保持屏幕常亮 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_section_top"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Mb.CardTitle"
                                    android:text="@string/settings_keep_screen_on" />

                                <TextView
                                    style="@style/Mb.CardDesc"
                                    android:text="@string/settings_keep_screen_on_desc" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swKeepScreenOn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <!-- 允许外部应用控制开发板（对外开发者接口总开关） -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Mb.CardTitle"
                                    android:text="@string/settings_ext_api" />

                                <TextView
                                    style="@style/Mb.CardDesc"
                                    android:text="@string/settings_ext_api_desc" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swExtApi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ 稳定性 ============ -->
                <TextView
                    style="@style/Mb.SectionHeader"
                    android:text="稳定性" />

                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <!-- 开机自检 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Mb.CardTitle"
                                    android:text="开机自检" />

                                <TextView
                                    style="@style/Mb.CardDesc"
                                    android:text="首次启动时自动检查权限 / 蓝牙 / 存储，异常项带一键修复" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swStartupSelfCheck"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <!-- 掉线自动重连 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Mb.CardTitle"
                                    android:text="掉线自动重连" />

                                <TextView
                                    style="@style/Mb.CardDesc"
                                    android:text="意外断线后按 1/2/4/8 秒退避重连，最多 10 次" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swAutoReconnect"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBatteryFix"
                            style="@style/Mb.Button.Tonal"
                            android:layout_marginTop="@dimen/space_section_top"
                            android:text="加入电池优化白名单"
                            app:icon="@drawable/ic_flash"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorOnSecondaryContainer" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNotifFix"
                            style="@style/Mb.Button.Outlined"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="通知渠道修复"
                            app:icon="@drawable/ic_bell"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStorageCleanup"
                            style="@style/Mb.Button.Outlined"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="存储可视化清理"
                            app:icon="@drawable/ic_clear"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCrashGuard"
                            style="@style/Mb.Button.Text"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="崩溃恢复保护说明"
                            app:icon="@drawable/ic_help"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ 指针 ============ -->
                <TextView
                    style="@style/Mb.SectionHeader"
                    android:text="@string/settings_section_pointer" />

                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Mb.CardTitle"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/settings_pointer_sensitivity" />

                            <TextView
                                android:id="@+id/tvPointerSens"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1.0×"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="?attr/colorPrimary" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderPointerSens"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            android:stepSize="0.2"
                            android:valueFrom="0.4"
                            android:valueTo="3.0" />

                        <TextView
                            style="@style/Mb.CardDesc"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/settings_pointer_sensitivity_desc" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ 通用 ============ -->
                <TextView
                    style="@style/Mb.SectionHeader"
                    android:text="@string/settings_section_general" />

                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <!-- 触感反馈 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Mb.CardTitle"
                                    android:text="@string/settings_haptic" />

                                <TextView
                                    style="@style/Mb.CardDesc"
                                    android:text="@string/settings_haptic_desc" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swHaptic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <!-- 更新通道：下拉选择稳定版 / 预览版 -->
                        <com.lingyi.mbos.ui.UpdateChannelPicker
                            android:id="@+id/channelPicker"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_section_top" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_section_top"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCheckUpdate"
                                style="@style/Mb.Button.Tonal"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/settings_check_update"
                                app:icon="@drawable/ic_refresh"
                                app:iconGravity="textStart"
                                app:iconSize="20dp"
                                app:iconTint="?attr/colorOnSecondaryContainer" />

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/pbCheckUpdate"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="@dimen/space_card"
                                android:indeterminate="true"
                                android:visibility="gone"
                                app:indicatorColor="?attr/colorPrimary"
                                app:indicatorSize="24dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvUpdateStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAbout"
                            style="@style/Mb.Button.Outlined"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/settings_about"
                            app:icon="@drawable/ic_info"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReset"
                            style="@style/Mb.Button.Text"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/settings_reset"
                            android:textColor="?attr/colorError"
                            app:icon="@drawable/ic_clear"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorError" />

                        <TextView
                            style="@style/Mb.CardDesc"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/settings_reset_desc" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_section_top"
                    android:text="10Y-灵逸云科技 · 灵逸 MB"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.lingyi.mbos.ui.MaxWidthFrameLayout>
</LinearLayout>
