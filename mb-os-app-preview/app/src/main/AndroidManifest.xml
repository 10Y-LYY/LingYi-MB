<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 联网检查更新（真实拉取 version.json） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 前台服务（常驻指针：退出界面/退出 App 仍持续运行） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 前台服务类型：本服务与已连接的 micro:bit 外设交互 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- 调试控制台前台服务类型：处理调试数据（dataSync 为 normal 权限，免运行时授权，规避 Android 15+ 崩溃） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 蓝牙（BLE 连接 micro:bit） -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!-- USB 主机（OTG 直连 micro:bit V2 的 CDC 串口） -->
    <uses-feature android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- 开发者模式：micro:bit V2 模拟器悬浮窗（在其它应用上层显示） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".MBOSApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.MBOS"
        tools:targetApi="34">

        <activity
            android:name=".GuideActivity"
            android:exported="false"
            android:theme="@style/Theme.MBOS.Guide" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MBOS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.MBOS.Preview" />

        <activity
            android:name=".CustomFlashActivity"
            android:exported="false"
            android:theme="@style/Theme.MBOS" />

        <activity
            android:name=".MakeCodeActivity"
            android:exported="false"
            android:theme="@style/Theme.MBOS" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.MBOS" />

        <!-- 稳定性工具二级页：引导页「问号」入口的目的地（4.1.1-preview） -->
        <activity
            android:name=".StabilityToolsActivity"
            android:exported="false"
            android:theme="@style/Theme.MBOS" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.MBOS" />

        <!-- 控制台「大方格」主题：分类功能的二级挑选页（结果回抛 MainActivity） -->
        <activity
            android:name=".ConsoleCategoryActivity"
            android:exported="false"
            android:theme="@style/Theme.MBOS" />

        <activity
            android:name=".DeveloperActivity"
            android:exported="false"
            android:theme="@style/Theme.MBOS" />

        <activity
            android:name=".LicenseActivity"
            android:exported="false"
            android:theme="@style/Theme.MBOS" />

        <activity
            android:name=".PointerModeActivity"
            android:exported="false"
            android:theme="@style/Theme.MBOS" />

        <!-- 无线指针（陀螺仪鼠标）：向任意 App 派发触摸手势 -->
        <service
            android:name=".PointerAccessibilityService"
            android:exported="false"
            android:label="@string/pointer_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/pointer_accessibility_service" />
        </service>

        <!-- 陀螺仪指针常驻前台服务：持有 MOUSE 数据循环 + 可拖动悬浮窗 -->
        <service
            android:name=".PointerService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- micro:bit V2 模拟器：开发者模式悬浮窗控制面板 -->
        <service
            android:name=".SimulatorService"
            android:exported="false" />

        <!-- 全局调试控制台悬浮窗（调试工具 + 问题上报检查器，4.1.0-preview） -->
        <service
            android:name=".DebugConsoleService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 日志反馈：把 logs/ crashes/ 与打包后的日志包授权给邮件/分享应用读取 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 对外开发者接口：其他 App 可通过本 Provider 把指令转发给已连接的 micro:bit。
             是否真正生效由应用内「允许外部应用控制开发板」开关决定（默认关，开发版默认开）。 -->
        <provider
            android:name=".ble.DeveloperApiProvider"
            android:authorities="${applicationId}.external"
            android:exported="true" />

        <!-- 以下组件仅「开发者测试版 / 预览版」(devtest / preview flavor) 注册：android:enabled 由 @bool/devtest_only 控制 -->
        <service
            android:name=".dev.ComponentInspectorService"
            android:exported="false"
            android:enabled="@bool/devtest_only" />
        <service
            android:name=".dev.DevHttpService"
            android:exported="false"
            android:enabled="@bool/devtest_only" />
        <activity
            android:name=".dev.DevToolsActivity"
            android:exported="false"
            android:enabled="@bool/devtest_only"
            android:theme="@style/Theme.MBOS" />

    </application>

</manifest>
