<?xml version="1.0" encoding="utf-8"?>
<!--
  自定义刷入页（M3 Expressive，v4.2 结构重排）：
  页面骨架与其余页面同构：MaterialToolbar + MaxWidthFrameLayout(≤840dp) + NestedScrollView
  （外部滚动兜底，etCode 高度收敛到 200dp 后小窗不再撑爆）。
  分组顺序调整为主业务优先：说明 → 预设小游戏 → 自定义代码 → 一键刷入 →
  稳定性工具（沉底）。分区标题走 Mb.SectionHeader（沿用各卡原标题案）。
  游戏三卡：shape_card 圆角令牌、46dp bg_icon_circle 图标圆、11sp 描述
  （M3 labelSmall 下限）、单行标题 + 双行描述 + 统一 minHeight 保证三卡等高。
  保留全部 id：etCode/tvMode/tvStatus/progressFlash/btnFlash/btnImport*/game*、
  tvFlashCheck/btnFlashSelfCheck/btnVerifyHex/btnFlashFailHelp。
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLow"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/custom_title" />

    <com.lingyi.mbos.ui.MaxWidthFrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:maxWidth="@dimen/content_max_width">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:clipToPadding="false"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_gutter_h_wide"
                android:paddingEnd="@dimen/page_gutter_h_wide"
                android:paddingTop="16dp"
                android:paddingBottom="32dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/custom_desc"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- ============ 预设小游戏（主业务） ============ -->
                <TextView
                    style="@style/Mb.SectionHeader"
                    android:text="@string/custom_games_title" />

                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <TextView
                            style="@style/Mb.CardDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_games_hint" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/gamePlane"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:minHeight="128dp"
                                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                                app:cardCornerRadius="@dimen/shape_card"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <FrameLayout
                                        android:layout_width="@dimen/icon_circle"
                                        android:layout_height="@dimen/icon_circle"
                                        android:background="@drawable/bg_icon_circle"
                                        android:backgroundTint="?attr/colorSurface">

                                        <androidx.appcompat.widget.AppCompatImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_gravity="center"
                                            android:importantForAccessibility="no"
                                            app:srcCompat="@drawable/ic_plane"
                                            app:tint="?attr/colorPrimary" />
                                    </FrameLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:text="@string/game_plane"
                                        android:textAppearance="?attr/textAppearanceLabelMedium"
                                        android:textColor="?attr/colorOnPrimaryContainer"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:ellipsize="end"
                                        android:maxLines="2"
                                        android:text="@string/game_plane_desc"
                                        android:textAlignment="center"
                                        android:textColor="?attr/colorOnPrimaryContainer"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/gameSnake"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:minHeight="128dp"
                                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                                app:cardCornerRadius="@dimen/shape_card"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <FrameLayout
                                        android:layout_width="@dimen/icon_circle"
                                        android:layout_height="@dimen/icon_circle"
                                        android:background="@drawable/bg_icon_circle"
                                        android:backgroundTint="?attr/colorSurface">

                                        <androidx.appcompat.widget.AppCompatImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_gravity="center"
                                            android:importantForAccessibility="no"
                                            app:srcCompat="@drawable/ic_snake"
                                            app:tint="?attr/colorPrimary" />
                                    </FrameLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:text="@string/game_snake"
                                        android:textAppearance="?attr/textAppearanceLabelMedium"
                                        android:textColor="?attr/colorOnPrimaryContainer"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:ellipsize="end"
                                        android:maxLines="2"
                                        android:text="@string/game_snake_desc"
                                        android:textAlignment="center"
                                        android:textColor="?attr/colorOnPrimaryContainer"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/gameBricks"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minHeight="128dp"
                                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                                app:cardCornerRadius="@dimen/shape_card"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <FrameLayout
                                        android:layout_width="@dimen/icon_circle"
                                        android:layout_height="@dimen/icon_circle"
                                        android:background="@drawable/bg_icon_circle"
                                        android:backgroundTint="?attr/colorSurface">

                                        <androidx.appcompat.widget.AppCompatImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_gravity="center"
                                            android:importantForAccessibility="no"
                                            app:srcCompat="@drawable/ic_bricks"
                                            app:tint="?attr/colorPrimary" />
                                    </FrameLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:text="@string/game_bricks"
                                        android:textAppearance="?attr/textAppearanceLabelMedium"
                                        android:textColor="?attr/colorOnPrimaryContainer"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:ellipsize="end"
                                        android:maxLines="2"
                                        android:text="@string/game_bricks_desc"
                                        android:textAlignment="center"
                                        android:textColor="?attr/colorOnPrimaryContainer"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ 自定义 Python / HEX（主业务） ============ -->
                <TextView
                    style="@style/Mb.SectionHeader"
                    android:text="@string/custom_py_label" />

                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <TextView
                            style="@style/Mb.CardDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_py_hint" />

                        <!-- 高度 260dp → 200dp：外部 NestedScrollView 兜底，小窗不再撑爆 -->
                        <EditText
                            android:id="@+id/etCode"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="12dp"
                            android:background="?attr/colorSurfaceContainerHigh"
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textNoSuggestions"
                            android:imeOptions="flagNoExtractUi"
                            android:padding="12dp"
                            android:scrollbars="vertical"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:typeface="monospace" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnImportPy"
                                style="@style/Mb.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/custom_import_py" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnImportHex"
                                style="@style/Mb.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:text="@string/custom_import_hex" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/custom_mode_py"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 页面唯一主 CTA -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFlash"
                    style="@style/Mb.Button.Filled"
                    android:layout_marginTop="18dp"
                    android:text="@string/custom_flash" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/custom_status_idle"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.lingyi.mbos.ui.BlockLoadingView
                    android:id="@+id/progressFlash"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />

                <!-- ============ 稳定性工具（沉底） ============ -->
                <TextView
                    style="@style/Mb.SectionHeader"
                    android:text="稳定性工具" />

                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <!-- 刷入前环境自检：OTG / 存储 / 文件就绪状态 -->
                        <TextView
                            android:id="@+id/tvFlashCheck"
                            style="@style/Mb.CardDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="检查中…" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFlashSelfCheck"
                            style="@style/Mb.Button.Tonal"
                            android:layout_marginTop="10dp"
                            android:text="🩺 刷入前环境自检" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVerifyHex"
                            style="@style/Mb.Button.Outlined"
                            android:layout_marginTop="8dp"
                            android:text="🔍 校验待刷入文件（HEX 格式）" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFlashFailHelp"
                            style="@style/Mb.Button.Text"
                            android:layout_marginTop="6dp"
                            android:text="🛟 刷入失败？排查与兜底" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="22dp"
                    android:text="10Y-灵逸云科技 · 灵逸 MB"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.lingyi.mbos.ui.MaxWidthFrameLayout>
</LinearLayout>
