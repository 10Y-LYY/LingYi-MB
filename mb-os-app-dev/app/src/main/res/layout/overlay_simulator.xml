<?xml version="1.0" encoding="utf-8"?>
<!--
  micro:bit V2 模拟器悬浮窗（开发者模式）：
  紧凑可拖拽卡片，不抢眼但功能完整——LED 预览 + 传感器值 + 按键/手势注入 +
  虚拟方向键（驱动 MOUSE 增量）+ 周期上报开关 + 断开。

  v4.2 令牌对齐（悬浮窗紧凑场景特例，全部 id 原样保留，SimulatorService 依赖）：
  - 按钮圆角统一走 @dimen/shape_btn 令牌（原依赖主题默认值）；
  - 图标按钮换 AppCompatImageButton + app:srcCompat（矢量加载兼容）；
  - 36dp 紧凑按钮高度、12sp/11sp 紧凑文字、SeekBar 姿态滑条均为悬浮窗特例保留；
  - 根背景 bg_overlay_sim 已令牌化，不动。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="268dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_sim"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- 标题行（同时是拖拽把手） -->
    <LinearLayout
        android:id="@+id/simHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sim_overlay_title"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnSimCollapse"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sim_collapse"
            android:padding="6dp"
            app:srcCompat="@drawable/ic_collapse_sim" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnSimClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sim_close"
            android:padding="6dp"
            app:srcCompat="@drawable/ic_close_sim" />
    </LinearLayout>

    <!-- 状态行 -->
    <TextView
        android:id="@+id/tvSimStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/sim_status_idle"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- LED 预览 + 传感器值 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.lingyi.mbos.ui.SimulatorLedView
            android:id="@+id/ledPreview"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="@string/sim_led_preview" />

        <TextView
            android:id="@+id/tvSimSensors"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="-"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- 按键 / 手势注入 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimA"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="@string/sim_btn_a"
            android:textSize="12sp"
            app:cornerRadius="@dimen/shape_btn"
            app:strokeColor="?attr/colorOutlineVariant"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimB"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/sim_btn_b"
            android:textSize="12sp"
            app:cornerRadius="@dimen/shape_btn"
            app:strokeColor="?attr/colorOutlineVariant"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimShake"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/sim_btn_shake"
            android:textSize="12sp"
            app:cornerRadius="@dimen/shape_btn"
            app:strokeColor="?attr/colorOutlineVariant"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- 虚拟方向键（驱动 MOUSE 倾斜增量） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimLeft"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="◀"
            android:textSize="14sp"
            app:cornerRadius="@dimen/shape_btn"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimUp"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="▲"
            android:textSize="14sp"
            app:cornerRadius="@dimen/shape_btn"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimDown"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="▼"
            android:textSize="14sp"
            app:cornerRadius="@dimen/shape_btn"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimRight"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="▶"
            android:textSize="14sp"
            app:cornerRadius="@dimen/shape_btn"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- 姿态微调（默认折叠，不占额外空间；展开即锁定手动 XYZ/朝向，暂停自动漂移） -->
    <LinearLayout
        android:id="@+id/simAttitudeHeader"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sim_attitude_title"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvSimAttitudeState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sim_attitude_auto"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorPrimary" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnSimAttitudeArrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/sim_attitude_title"
            app:srcCompat="@drawable/ic_collapse_sim" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/simAttitudePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- X 轴 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="16dp"
                android:layout_height="wrap_content"
                android:text="@string/sim_attitude_axis_x"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <SeekBar
                android:id="@+id/seekSimX"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="4095"
                android:progress="2048" />

            <TextView
                android:id="@+id/tvSimXVal"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Y 轴 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="16dp"
                android:layout_height="wrap_content"
                android:text="@string/sim_attitude_axis_y"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <SeekBar
                android:id="@+id/seekSimY"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="4095"
                android:progress="2048" />

            <TextView
                android:id="@+id/tvSimYVal"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Z 轴 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="16dp"
                android:layout_height="wrap_content"
                android:text="@string/sim_attitude_axis_z"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <SeekBar
                android:id="@+id/seekSimZ"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="4095"
                android:progress="3072" />

            <TextView
                android:id="@+id/tvSimZVal"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="-1024"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- 朝向 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="16dp"
                android:layout_height="wrap_content"
                android:text="@string/sim_attitude_heading"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <SeekBar
                android:id="@+id/seekSimC"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="359"
                android:progress="135" />

            <TextView
                android:id="@+id/tvSimCVal"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="135°"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimAttitudeAuto"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="@string/sim_attitude_resume"
            android:textSize="11sp"
            app:cornerRadius="@dimen/shape_btn"
            app:icon="@drawable/ic_refresh"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="14dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- 动作行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimPeriodic"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="@string/sim_periodic_on"
            android:textSize="12sp"
            app:cornerRadius="@dimen/shape_btn"
            app:icon="@drawable/ic_refresh"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="14dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimDisconnect"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/sim_disconnect"
            android:textSize="12sp"
            app:cornerRadius="@dimen/shape_btn"
            app:icon="@drawable/ic_bluetooth"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="14dp"
            app:iconTint="?attr/colorError"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
