<?xml version="1.0" encoding="utf-8"?>
<!--
  预览页（M3 Expressive 重排）：
  - 大图卡圆角统一 @dimen/shape_card、内边距统一 16dp；
  - 信息卡动态容器 infoList 原样保留（行布局见 item_info_row）；
  - 稳定性工具卡保留全部 id，按钮按 Mb.Button.Tonal / Outlined 分级，emoji 换矢量图标。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLow"
    android:orientation="vertical">

    <!-- 顶栏：原生 MaterialToolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="预览模式"
        app:menu="@menu/top_preview" />

    <!-- 大屏内容封顶居中（M3 规范：单列 ≤840dp，手机窄屏零副作用） -->
    <com.lingyi.mbos.ui.MaxWidthFrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:maxWidth="@dimen/content_max_width">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:clipToPadding="false"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_gutter_h"
                android:paddingTop="@dimen/space_card"
                android:paddingEnd="@dimen/page_gutter_h"
                android:paddingBottom="28dp">

                <!-- 大图（开发实图） -->
                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout
                        style="@style/Mb.Page.CardBody"
                        android:gravity="center_horizontal">

                        <!-- 宽度撑满内容区，高度按图片真实宽高比（792×636）自适应，避免固定盒造成的留白/拉伸 -->
                        <ImageView
                            android:id="@+id/bigBoard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/app_name"
                            android:maxHeight="@dimen/big_board_max_height"
                            android:scaleType="fitCenter"
                            android:src="@drawable/microbit_v2" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvPreviewState"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="未连接"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/pbRefresh"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="@dimen/space_card"
                                android:indeterminate="true"
                                android:visibility="gone"
                                app:indicatorColor="?attr/colorPrimary"
                                app:indicatorSize="16dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 实时读取开关：文字组 + MaterialSwitch 横排 -->
                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout
                        style="@style/Mb.Page.CardBody"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Mb.CardTitle"
                                android:text="实时读取" />

                            <TextView
                                style="@style/Mb.CardDesc"
                                android:text="开启后每秒自动刷新开发板全部信息" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swRealtime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 信息卡（动态行容器 infoList 保留） -->
                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout
                        android:id="@+id/infoList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- 稳定性工具：快照对比 / 读数 CSV 导出 -->
                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <TextView
                            style="@style/Mb.CardTitle"
                            android:text="稳定性工具" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSnapshotCompare"
                            style="@style/Mb.Button.Tonal"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="快照对比（与上次读数找差异）"
                            app:icon="@drawable/ic_plot"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorOnSecondaryContainer" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportCsv"
                            style="@style/Mb.Button.Outlined"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="导出读数 CSV（本页采样）"
                            app:icon="@drawable/ic_tempchart"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_card"
                    android:gravity="center"
                    android:text="@string/preview_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.lingyi.mbos.ui.MaxWidthFrameLayout>
</LinearLayout>
