<?xml version="1.0" encoding="utf-8"?>
<!--
  陀螺仪指针页（M3 Expressive 重排）：
  - 全卡统一 Mb.Page.Card（20dp 圆角 / 无描边 / 零 elevation）；
    常驻运行卡保留为唯一 Mb.Page.Card.Accent 强调卡；使用说明卡保留 TertiaryContainer tonal 语义；
  - 高级控制卡内容按「手感 / 映射与模式」拆 tonal 子卡分组；
  - 开关行统一「文字组 + MaterialSwitch」横排（id 不变，文案移到左侧文字组）；
  - Spinner 触达区保持 120dp；三个 Slider 的 valueFrom/valueTo/stepSize 原样保留；
  - 全部 view id 原样保留。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLow"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/pointer_title" />

    <!-- 大屏内容封顶居中（M3 规范：单列 ≤840dp，手机窄屏零副作用） -->
    <com.lingyi.mbos.ui.MaxWidthFrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:maxWidth="@dimen/content_max_width">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:clipToPadding="false"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_gutter_h"
                android:paddingTop="@dimen/space_card"
                android:paddingEnd="@dimen/page_gutter_h"
                android:paddingBottom="28dp">

                <!-- 常驻运行：退出本页甚至退出 App 后仍持续工作（全页唯一强调卡） -->
                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card.Accent">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <TextView
                            style="@style/Mb.CardTitle"
                            android:text="@string/pointer_run_title"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:id="@+id/tvRunState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/pointer_run_idle"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleRun"
                            style="@style/Mb.Button.Tonal"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/pointer_start"
                            app:icon="@drawable/ic_pointer"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorOnSecondaryContainer" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 状态卡：连接 + 无障碍服务 -->
                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <TextView
                            style="@style/Mb.CardTitle"
                            android:text="@string/pointer_status_title" />

                        <TextView
                            android:id="@+id/tvConnState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/pointer_not_connected"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEnableService"
                            style="@style/Mb.Button.Tonal"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/pointer_btn_enable"
                            app:icon="@drawable/ic_sensor"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorOnSecondaryContainer" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCalibrate"
                            style="@style/Mb.Button.Outlined"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/pointer_cal"
                            app:icon="@drawable/ic_compass"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 实时数据 -->
                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <TextView
                            style="@style/Mb.CardTitle"
                            android:text="@string/pointer_live_title" />

                        <TextView
                            style="@style/Mb.CardDesc"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/pointer_live_hint" />

                        <TextView
                            android:id="@+id/tvLive"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            android:fontFamily="monospace"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/pointer_live_idle"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:textIsSelectable="true" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 稳定性工具：掉线保护 / 手感一键复位 -->
                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <TextView
                            style="@style/Mb.CardTitle"
                            android:text="稳定性工具" />

                        <!-- 掉线保护：指针服务运行中断线时显式告警 + 一键重连 -->
                        <TextView
                            android:id="@+id/tvDropGuard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            android:lineSpacingExtra="3dp"
                            android:text="-"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReconnectNow"
                            style="@style/Mb.Button.Tonal"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="立即重连（掉线时点这里）"
                            app:icon="@drawable/ic_linkmonitor"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorOnSecondaryContainer" />

                        <!-- 全 App 最长按钮：maxLines=2 不裁切，wrap_content 高度无固定值 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnResetSens"
                            style="@style/Mb.Button.Outlined"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="一键复位手感（灵敏度 / 死区 / 平滑 / 曲线）"
                            app:icon="@drawable/ic_refresh"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 高级控制：手感 / 映射与模式 两组 tonal 子卡 -->
                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <TextView
                            style="@style/Mb.CardTitle"
                            android:text="@string/pointer_advanced_title" />

                        <TextView
                            style="@style/Mb.CardDesc"
                            android:layout_marginTop="@dimen/space_card"
                            android:text="@string/pointer_advanced_hint" />

                        <!-- 手感组：曲线 / 抗漂移死区 / 移动平滑 -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                            app:cardCornerRadius="@dimen/shape_inner"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout style="@style/Mb.Page.CardBody">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        style="@style/Mb.InfoLabel"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/pointer_curve" />

                                    <Spinner
                                        android:id="@+id/spinnerCurve"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minWidth="120dp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvDeadzone"
                                    style="@style/Mb.InfoLabel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_card"
                                    android:text="@string/pointer_deadzone" />

                                <com.google.android.material.slider.Slider
                                    android:id="@+id/sliderDeadzone"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:stepSize="1"
                                    android:valueFrom="0"
                                    android:valueTo="6" />

                                <TextView
                                    android:id="@+id/tvSmooth"
                                    style="@style/Mb.InfoLabel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_card"
                                    android:text="@string/pointer_smoothing" />

                                <com.google.android.material.slider.Slider
                                    android:id="@+id/sliderSmooth"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:stepSize="0.1"
                                    android:valueFrom="0"
                                    android:valueTo="0.9" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- 映射与模式组：按钮 A/B 动作 + 滚动模式 + 自动回中 -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                            app:cardCornerRadius="@dimen/shape_inner"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout style="@style/Mb.Page.CardBody">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        style="@style/Mb.InfoLabel"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/pointer_btn_a" />

                                    <Spinner
                                        android:id="@+id/spinnerBtnA"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minWidth="120dp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_card"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        style="@style/Mb.InfoLabel"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/pointer_btn_b" />

                                    <Spinner
                                        android:id="@+id/spinnerBtnB"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minWidth="120dp" />
                                </LinearLayout>

                                <!-- 滚动模式 -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_card"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        style="@style/Mb.InfoLabel"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/pointer_scroll_mode" />

                                    <com.google.android.material.materialswitch.MaterialSwitch
                                        android:id="@+id/switchScroll"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />
                                </LinearLayout>

                                <!-- 空闲自动回中 -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_card"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        style="@style/Mb.InfoLabel"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/pointer_autorecenter" />

                                    <com.google.android.material.materialswitch.MaterialSwitch
                                        android:id="@+id/switchAutorecenter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 灵敏度 -->
                <com.google.android.material.card.MaterialCardView style="@style/Mb.Page.Card">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Mb.CardTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/pointer_sensitivity" />

                            <TextView
                                android:id="@+id/tvSensitivity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1.0×"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="?attr/colorPrimary" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderSensitivity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            android:stepSize="0.2"
                            android:valueFrom="0.4"
                            android:valueTo="3.0" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 使用说明（TertiaryContainer tonal 语义保留） -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_card"
                    app:cardBackgroundColor="?attr/colorTertiaryContainer"
                    app:cardCornerRadius="@dimen/shape_card"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout style="@style/Mb.Page.CardBody">

                        <TextView
                            style="@style/Mb.CardTitle"
                            android:text="@string/pointer_usage_title"
                            android:textColor="?attr/colorOnTertiaryContainer" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_card"
                            android:lineSpacingExtra="4dp"
                            android:text="@string/pointer_usage_text"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnTertiaryContainer" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.lingyi.mbos.ui.MaxWidthFrameLayout>
</LinearLayout>
